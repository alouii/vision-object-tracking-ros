<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="tracking_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Target Object (RED BOX) -->
    <model name="target">
      <pose>2 0 0.1 0 0 0</pose>
      <link name="link">
        <visual>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
