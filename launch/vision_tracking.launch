<launch>

	<!-- Parameters for vision node -->
	<arg name="visualize" default="true" />
	<arg name="image_topic" default="/camera/image_raw" />
	<arg name="output_topic" default="/object_position" />

	<!-- HSV thresholds (defaults match code) -->
	<arg name="h_min" default="0" />
	<arg name="s_min" default="120" />
	<arg name="v_min" default="70" />
	<arg name="h_max" default="10" />
	<arg name="s_max" default="255" />
	<arg name="v_max" default="255" />

	<!-- Launch vision processing node -->
	<!-- Load params from YAML (overridable via args) -->
	<rosparam file="$(find vision_object_tracking)/config/vision_params.yaml" command="load"/>

	<node name="vision_node" pkg="vision_object_tracking" type="vision_node" output="screen">
		<!-- individual params are still overridable via cmdline/args -->
	</node>

	<!-- Controller node -->
	<node name="controller_node" pkg="vision_object_tracking" type="controller_node" output="screen">
		<!-- Image size should match camera plugin in URDF -->
		<param name="image_width" value="640" />
		<param name="image_height" value="480" />
		<!-- Subscribe to detection topic published by vision node -->
		<param name="object_topic" value="$(arg output_topic)_detection" />
	</node>

</launch>
